{
  "name": "pdf-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "브라우저에서만 동작하는 PDF 편집기. 편집, 병합, 추출, 분할, 워터마크, 서명을 파일 업로드 없이 처리합니다.",
  "keywords": [
    "pdf",
    "pdf-editor",
    "pdf-merge",
    "pdf-split",
    "watermark",
    "signature",
    "pdfjs",
    "pdf-lib",
    "client-side",
    "korean"
  ],
  "homepage": "https://gridex-khj.github.io/Pdf/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gridex-khj/Pdf.git"
  },
  "bugs": {
    "url": "https://github.com/gridex-khj/Pdf/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.5",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
